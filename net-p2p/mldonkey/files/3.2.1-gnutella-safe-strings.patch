+          let pkt_hops = get_uint8 bbuf  (b.pos+18) in
+          let data = String.sub bbuf (b.pos+23) msg_len in
           buf_used b (msg_len + 23);
           let pkt = {
               pkt_uid = pkt_uid;
@@ -831,7 +832,7 @@ let create_qrt_table words table_size =
