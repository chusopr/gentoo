-	AS2(	sub ecx, edx)	// hold the distance between C & A so we can add this to A to get C
-	AS2(	xor eax, eax)	// clear eax
-
-	AS2(	sub eax, esi)	// eax is a negative index from end of B
-	AS2(	lea ebx, [ebx+4*esi])	// ebx is end of B
-
