-unsigned int OID::DecodeValue(BufferedTransformation &bt, unsigned long &v)
-{
-	byte b;
-	unsigned int i=0;
-	v = 0;
-	while (true)
-	{
-		if (!bt.Get(b))
-			BERDecodeError();
-		i++;
-		v <<= 7;
-		v += b & 0x7f;
-		if (!(b & 0x80))
-			return i;
-	}
-}
