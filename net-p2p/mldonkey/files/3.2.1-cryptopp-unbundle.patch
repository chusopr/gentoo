-void BERDecodeNull(BufferedTransformation &in)
-{
-	byte b;
-	if (!in.Get(b) || b != TAG_NULL)
-		BERDecodeError();
-	unsigned int length;
-	if (!BERLengthDecode(in, length) || length != 0)
-		BERDecodeError();
