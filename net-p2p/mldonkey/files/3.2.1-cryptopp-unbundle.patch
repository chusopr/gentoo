-template <class T>
-inline T GetWord(bool assumeAligned, ByteOrder order, const byte *block)
-{
-	if (assumeAligned)
-	{
-		assert(IsAligned<T>(block));
-		return ConditionalByteReverse(order, *reinterpret_cast<const T *>(block));
-	}
-	else
-		return UnalignedGetWord<T>(order, block);
